# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/portals/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-build/
/.next-e2e/
/.next-e2e-*/
/.next-qa-*/
/out/

# production
/build
/builds/
/portals/dist/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
/.devserver*.log
/playwright-report/
/test-results/
/artifacts/
/assets/source/

# local scaffold scratch space; never commit its nested dependency tree
/miw-scaffold/

# compiled output of the sculpt review harness (regenerate with its tsconfig)
/assets/reference/*/preview/js/

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# session build variants (generalizes the specific .next-* entries above)
/.next-*/
/.playwright-mcp/
/portals/dist-*/
__pycache__/

# sculpt review renders: regenerable from spec + factory via the preview
# harness; the specs' reviewHistory references them by path but the specs are
# the source of truth. Reference images, specs, evidence JSONs and measure
# scripts ARE committed - only rendered review output is not.
/assets/reference/*/renders/
