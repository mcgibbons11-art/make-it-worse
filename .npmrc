# This repository lives inside a synced Dropbox folder. pnpm's default layout
# links every package into node_modules with symlinks, which Dropbox does not
# preserve; a sync silently strips them and leaves an unresolvable tree. The
# hoisted linker writes real directories instead, at the cost of some disk.
# Dependency resolution still comes from pnpm-lock.yaml and is unchanged.
node-linker=hoisted
